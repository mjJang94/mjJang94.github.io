---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { formatDate } from '../../site.config';

export async function getStaticPaths() {
  const entries = await getCollection('experience', ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'experience'>;
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.title} · ${site.name}`} description={d.summary}>
  <article class="detail">
    <a class="back" href="/">← 목록으로</a>
    <h1 class="detail__title">{d.title}</h1>
    <p class="detail__summary">{d.summary}</p>

    <div class="spec">
      <div>
        <span class="spec__key">date</span>
        <span class="spec__value">{formatDate(d.date)}</span>
      </div>
      <div>
        <span class="spec__key">topic</span>
        <span class="spec__value">{d.topic}</span>
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
